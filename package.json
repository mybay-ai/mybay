{
    "name": "mybay-local",
    "version": "0.1.0-preview",
    "description": "A local-first, self-hosted control plane for managing Hermes Agent instances.",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/mybay-ai/mybay.git"
    },
    "homepage": "https://github.com/mybay-ai/mybay#readme",
    "bugs": {
        "url": "https://github.com/mybay-ai/mybay/issues"
    },
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "dev": "npm run docs:build && tsx server.ts",
        "build": "npm run docs:build && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
        "docs:check": "tsx scripts/docs-build.ts",
        "docs:build": "tsx scripts/docs-build.ts --write",
        "docs:test": "vitest run src/lib/docs",
        "start": "node dist/server.cjs",
        "typecheck": "tsc --noEmit",
        "typecheck:strict-core": "tsc -p tsconfig.strict.json --noEmit",
        "test": "vitest run",
        "test:schema": "vitest run server/runtimeSchema.test.ts",
        "test:docker-e2e": "vitest run server/dockerLifecycle.e2e.test.ts",
        "check:mojibake": "node scripts/check-mojibake.mjs",
        "check:local-copy": "node scripts/check-local-edition-copy.mjs",
        "check": "npm run docs:check && npm run typecheck && npm run typecheck:strict-core && npm run test && npm run check:mojibake && npm run check:local-copy && npm run check:i18n && npm run check:i18n-hardcode && npm run check:i18n-fallbacks && npm run check:api-error-contract && npm run build",
        "lint": "npm run typecheck",
        "check:i18n": "node scripts/check-i18n-keys.mjs",
        "check:i18n-hardcode": "node scripts/check-i18n-hardcode.mjs",
        "check:i18n-fallbacks": "node scripts/check-i18n-fallbacks.mjs",
        "check:api-error-contract": "node scripts/check-api-error-contract.mjs",
        "check:version": "node scripts/check-version.mjs",
        "release:create": "node scripts/create-release.mjs",
        "release:check": "node scripts/check-release-archive.mjs"
    },
    "dependencies": {
        "@google/genai": "^2.4.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.1.14",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/react-dom": "^19.2.3",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react": "^5.0.4",
        "adm-zip": "^0.6.0",
        "archiver": "^8.0.0",
        "bcryptjs": "^3.0.3",
        "clsx": "^2.1.1",
        "cron-parser": "^5.5.0",
        "dockerode": "^5.0.0",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "express-rate-limit": "^8.5.2",
        "i18next": "^26.3.1",
        "ipaddr.js": "^2.4.0",
        "js-yaml": "^4.2.0",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^0.546.0",
        "motion": "^12.23.24",
        "multer": "^2.1.1",
        "pdf-parse": "^2.4.5",
        "qrcode.react": "^4.2.0",
        "react": "^19.0.1",
        "react-dom": "^19.0.1",
        "react-helmet-async": "^3.0.0",
        "react-i18next": "^17.0.8",
        "react-icons": "^5.6.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.1.5",
        "remark-gfm": "^4.0.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.6.0",
        "tar-fs": "^3.1.2",
        "vite": "^6.2.3"
    },
    "devDependencies": {
        "@types/adm-zip": "^0.5.8",
        "@types/archiver": "^8.0.0",
        "@types/dockerode": "^4.0.1",
        "@types/express": "^4.17.21",
        "@types/js-yaml": "^4.0.9",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.14.0",
        "@types/pdf-parse": "^1.1.5",
        "autoprefixer": "^10.4.21",
        "esbuild": "^0.25.0",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.21.0",
        "typescript": "~5.8.2",
        "vite": "^6.2.3",
        "vitest": "^4.1.8"
    }
}

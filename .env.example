# ===================================================================
# MyBay Open Source Agent Management Platform - Environment Configuration
# ===================================================================

# Server Port and Runtime Environment
PORT=3000
NODE_ENV=development
# Version-pinned control-panel image used by the Windows one-click package.
MYBAY_CONTROL_PANEL_IMAGE=ghcr.io/mybay-ai/mybay:0.1.27-rc.2

# -------------------------------------------------------------------
# Security & Authentication
# -------------------------------------------------------------------
# Local administrator credentials for web console login
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=change-me-now

# Secret key used for signing JWT session tokens (Minimum 32 bytes)
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-32-byte-secret

# 64-character hex key used for AES-256 encryption of API keys & credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-64-character-hex-secret

# -------------------------------------------------------------------
# Host Resource Guard Limits
# -------------------------------------------------------------------
MAX_INSTANCE_COUNT=10
DEFAULT_INSTANCE_MEMORY=1024m
DEFAULT_INSTANCE_CPUS=1
DEFAULT_INSTANCE_DISK_MB=4096

# Chat attachments are host-protection defaults, not product quotas.
# Use 0 or unlimited for no count/size limit. Use * to allow any extension.
CHAT_ATTACHMENT_MAX_FILES=20
CHAT_ATTACHMENT_MAX_FILE_MB=100
CHAT_ATTACHMENT_ALLOWED_EXTENSIONS=*

# -------------------------------------------------------------------
# Local Data Persistence
# -------------------------------------------------------------------
MYBAY_SQLITE_PATH=data/mybay.sqlite
LOCAL_DATA_DIR=data

# -------------------------------------------------------------------
# Hermes Agent & Docker Settings
# -------------------------------------------------------------------
MY_BAY_GITHUB_REPO=nousresearch/hermes-agent
MY_BAY_IMAGE=nousresearch/hermes-agent
MY_BAY_INCLUDE_PRERELEASE=false
# First official Hermes release with native Feishu/Lark support.
HERMES_NATIVE_FEISHU_MIN_VERSION=v2026.3.30

MY_BAY_PORT_START=10100
MY_BAY_PORT_END=19999
MYBAY_ENABLE_SIMULATED_DEPLOYMENT=false
MYBAY_DEPLOYMENT_LEASE_SECONDS=45
MYBAY_CLEANUP_MAX_ATTEMPTS=3

# DNS used by the control-panel container for OAuth/QR provider APIs.
# Quick Start detects the host DNS automatically; manual deployments may override it.
MYBAY_CONTROL_PANEL_DNS=
# Comma-separated DNS servers passed to Agent containers.
MYBAY_CONTAINER_DNS=1.1.1.1,8.8.8.8

# -------------------------------------------------------------------
# Local Feature Flags & URLs
# -------------------------------------------------------------------
# Optional template/Blueprint automation extension. Disabled by default in MyBay Open Source.
# Set both values to true only when intentionally enabling the experimental extension.
TEMPLATE_CENTER_ENABLED=false
SCHEDULER_RUNNER_ENABLED=false
# Optional manual CPU/memory/disk policy management. Core Docker safeguards stay enabled.
MYBAY_ADVANCED_RESOURCE_CONFIG_ENABLED=false


# Interactive Agent Runs initiated manually from the chat workspace.
# Independent from Scheduler automatic task execution.
MYBAY_ASYNC_CHAT_RUNS_ENABLED=true
# The supported local Hermes Runtime persists native-session history. Avoid
# replaying the same database history on every turn; set false only as a
# compatibility rollback for a Runtime without durable session continuity.
MYBAY_DEDUPLICATE_CHAT_HISTORY=true
TRUST_PROXY=false
# Access scenario: desktop | lan | server
# desktop: 127.0.0.1 only; lan: choose an exact host IPv4 in the first-run UI;
# server: requires PROXY_MODE=traefik and a real BASE_DOMAIN.
DEPLOYMENT_MODE=desktop
# Unsafe compatibility only. Requires an instance explicitly configured as
# webhookAuthMode=legacy-open. Startup emits a mode-specific security warning.
MYBAY_ALLOW_LEGACY_OPEN_WEBHOOKS=false

PROXY_MODE=local
CONTROL_PANEL_BIND_IP=127.0.0.1
DEPLOYMENT_LAN_BIND_IP=
LOCAL_INSTANCE_ACCESS_HOST=
CONTROL_PANEL_DOMAIN=
MYBAY_INSTANCE_ROOT_DOMAIN=
LETSENCRYPT_EMAIL=
TRAEFIK_NETWORK=traefik_proxy
TRAEFIK_CONTAINER_NAME=traefik
INSTANCE_PUBLIC_PROTOCOL=http
CONTROL_PLANE_INTERNAL_URL=
INSTANCE_AUTH_INTERNAL_URL=

BASE_DOMAIN=localhost
PUBLIC_APP_URL=http://localhost:3000
# VITE_* values are embedded into the frontend during docker compose build.
VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_MYBAY_PLATFORM_ORIGIN=http://localhost:3000

# Secret used to authenticate internal instance routing requests (64 hex characters)
MYBAY_INTERNAL_ROUTING_SECRET=replace-with-a-64-character-hex-routing-secret

# Concurrent Run reconciliation across different instances (1-16, default 4).
# Runs belonging to the same instance remain strictly serialized.
MYBAY_RUN_RECONCILER_CONCURRENCY=4

# Optional A2A task tracking relay. Explicit caller instance IDs are required.
# Empty scope keeps direct transport. Reapply selected instances after changing
# these settings; the control container must reach their private Docker networks.
MYBAY_A2A_TASK_TRACKING=false
MYBAY_A2A_TRACKED_INSTANCES=
